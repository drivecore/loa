{
  "name": "loa-monorepo",
  "version": "0.0.0",
  "private": true,
  "homepage": "https://landofassets.com",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "build": "pnpm -r build",
    "tsc": "tsc -b",
    "test": "vitest run",
    "format": "oxfmt .",
    "lint": "oxlint --type-aware --type-check packages/*/src",
    "lint:fix": "oxlint --type-aware --type-check --fix packages/*/src",
    "loa": "node packages/cli/dist/bin/loa.js",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@anolilab/semantic-release-pnpm": "^8.1.29",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^22.20.5",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "semantic-release": "^25.0.9",
    "typescript": "7.1.0-beta",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --type-aware --type-check --fix --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,md,mdx,css,html,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.16.1"
}
